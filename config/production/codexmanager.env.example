# Controlled production template for a separate Service + Web deployment.
# Copy to `codexmanager.env` outside Git and replace every value marked
# REPLACE_ME before starting any process. Do not put database passwords or API
# tokens in this tracked template.

# Bind local listeners and expose only the Web port through the reverse proxy.
CODEXMANAGER_SERVICE_ADDR=127.0.0.1:48760
CODEXMANAGER_WEB_ADDR=127.0.0.1:48761
CODEXMANAGER_LOGIN_ADDR=127.0.0.1:1455
CODEXMANAGER_ALLOW_NON_LOOPBACK_LOGIN_ADDR=0
CODEXMANAGER_WEB_NO_OPEN=1
CODEXMANAGER_WEB_NO_SPAWN_SERVICE=1

# Use the remote database built into the selected Service/Web/Start binaries.
# Keep this URL in a secret manager or a mode-600 environment file.
CODEXMANAGER_STORAGE_BACKEND=mysql
CODEXMANAGER_DATABASE_URL=mysql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_DB_HOST:3306/REPLACE_ME_DATABASE
CODEXMANAGER_DB_MAX_CONNECTIONS=10
CODEXMANAGER_DB_ACQUIRE_TIMEOUT_MS=5000

# Mount this file from the secret manager; never commit its contents.
CODEXMANAGER_RPC_TOKEN_FILE=/run/codexmanager/rpc-token

# Real provider endpoint and conservative production transport defaults.
CODEXMANAGER_UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
CODEXMANAGER_UPSTREAM_TOTAL_TIMEOUT_MS=0
CODEXMANAGER_UPSTREAM_STREAM_TIMEOUT_MS=600000
CODEXMANAGER_HTTP_TIMEOUT_MS=120000
CODEXMANAGER_SSE_KEEPALIVE_ENABLED=1
CODEXMANAGER_SSE_KEEPALIVE_INTERVAL_MS=15000
CODEXMANAGER_GATEWAY_ASYNC_STREAM_WORKERS=32
CODEXMANAGER_FRONT_PROXY_MAX_BODY_BYTES=0
CODEXMANAGER_FRONT_PROXY_ZSTD_MAX_BODY_BYTES=268435456

# Keep experimental transports and polling disabled until explicitly accepted.
CODEXMANAGER_USE_WEBSOCKET_UPSTREAM=0
CODEXMANAGER_USAGE_POLLING_ENABLED=0
CODEXMANAGER_TOKEN_REFRESH_POLLING_ENABLED=0
CODEXMANAGER_WARMUP_CRON_ENABLED=0

# Set a production timezone explicitly.
TZ=Asia/Shanghai
